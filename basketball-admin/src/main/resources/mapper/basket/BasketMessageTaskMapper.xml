<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.basket.mapper.BasketMessageTaskMapper">
    <resultMap type="com.zhs.basket.domain.BasketMessageTask" id="BasketMessageTaskResult">
        <id property="id" column="id" />
        <result property="taskNo" column="task_no" />
        <result property="messageType" column="message_type" />
        <result property="title" column="title" />
        <result property="contentText" column="content_text" />
        <result property="bizType" column="biz_type" />
        <result property="bizId" column="biz_id" />
        <result property="sendScope" column="send_scope" />
        <result property="sendStatus" column="send_status" />
        <result property="scheduledTime" column="scheduled_time" />
        <result property="sentTime" column="sent_time" />
        <result property="totalCount" column="total_count" />
        <result property="successCount" column="success_count" />
        <result property="failCount" column="fail_count" />
        <result property="creatorId" column="creator_id" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="isDelete" column="is_delete" />
    </resultMap>    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into basket_message_task (task_no, message_type, title, content_text, biz_type, biz_id, send_scope, send_status, scheduled_time, sent_time, total_count, success_count, fail_count, creator_id, create_time, update_time, is_delete) values (#{taskNo}, #{messageType}, #{title}, #{contentText}, #{bizType}, #{bizId}, #{sendScope}, #{sendStatus}, #{scheduledTime}, #{sentTime}, #{totalCount}, #{successCount}, #{failCount}, #{creatorId}, #{createTime}, #{updateTime}, #{isDelete})
    </insert>

    <select id="countByBizTypeAndBizId" resultType="int">
        select count(1) from basket_message_task
        where biz_type = #{bizType} and biz_id = #{bizId} and is_delete = 0
    </select>
</mapper>
