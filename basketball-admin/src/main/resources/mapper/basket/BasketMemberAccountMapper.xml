<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.basket.mapper.BasketMemberAccountMapper">
    <resultMap type="com.zhs.basket.domain.BasketMemberAccount" id="BasketMemberAccountResult">
        <id property="id" column="id" />
        <result property="accountNo" column="account_no" />
        <result property="username" column="username" />
        <result property="email" column="email" />
        <result property="accountStatus" column="account_status" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="isDelete" column="is_delete" />
    </resultMap>
    <select id="selectById" resultMap="BasketMemberAccountResult">
        select id, account_no, username, email, account_status, create_time, update_time, is_delete from basket_member_account where id = #{id} and is_delete = 0
    </select>
</mapper>
