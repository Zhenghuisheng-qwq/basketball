<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.basket.mapper.BasketVenueMapper">
    <resultMap type="com.zhs.basket.domain.BasketVenue" id="BasketVenueResult">
        <id property="id" column="id" />
        <result property="venueNo" column="venue_no" />
        <result property="venueName" column="venue_name" />
        <result property="provinceCode" column="province_code" />
        <result property="provinceName" column="province_name" />
        <result property="cityCode" column="city_code" />
        <result property="cityName" column="city_name" />
        <result property="address" column="address" />
        <result property="contactName" column="contact_name" />
        <result property="contactPhone" column="contact_phone" />
        <result property="capacity" column="capacity" />
        <result property="longitude" column="longitude" />
        <result property="latitude" column="latitude" />
        <result property="venueStatus" column="venue_status" />
        <result property="remark" column="remark" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="isDelete" column="is_delete" />
    </resultMap>
    <select id="selectSimpleList" resultType="com.zhs.basket.vo.VenueSimpleVo">
        select id, venue_no, venue_name, address
        from basket_venue where is_delete = 0 and venue_status = 1
        order by venue_name
    </select>
    <select id="selectById" resultMap="BasketVenueResult">
        select id, venue_no, venue_name, province_code, province_name, city_code, city_name, address, contact_name,
               contact_phone, capacity, longitude, latitude, venue_status, remark, create_time, update_time, is_delete
        from basket_venue where id = #{id} and is_delete = 0
    </select>
</mapper>
