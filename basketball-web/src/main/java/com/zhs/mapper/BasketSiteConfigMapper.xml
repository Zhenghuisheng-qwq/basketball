<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketSiteConfigDao">
	<resultMap id="result_BasketSiteConfigMapper.xml" type="com.zhs.model.BasketSiteConfig">
		<id column="id" property="id" />
		<result column="config_key" property="configKey" />
		<result column="config_name" property="configName" />
		<result column="config_value" property="configValue" />
		<result column="value_type" property="valueType" />
		<result column="group_code" property="groupCode" />
		<result column="public_flag" property="publicFlag" />
		<result column="config_status" property="configStatus" />
		<result column="remark" property="remark" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<!-- 数据库中表名为:basket_site_config的列名 -->
	<sql id="basket_site_config_Column">
		id,config_key,config_name,config_value,value_type,group_code,public_flag,config_status,remark,create_time,update_time,is_delete
	</sql>

	<!-- 通过BasketSiteConfig的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketSiteConfigById" parameterType="Long" resultMap="result_BasketSiteConfigMapper.xml">
		select
		<include refid="basket_site_config_Column" />
		from basket_site_config
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketSiteConfig对象,以参数BasketSiteConfig对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketSiteConfigObjSingle" parameterType="com.zhs.model.BasketSiteConfig" resultMap="result_BasketSiteConfigMapper.xml">
		select
		<include refid="basket_site_config_Column" />
		from basket_site_config
		<where>
		<if test="configValue != null"> and config_value = #{configValue}</if>
		<if test="valueType != null"> and value_type = #{valueType}</if>
		<if test="groupCode != null"> and group_code = #{groupCode}</if>
		<if test="publicFlag != null"> and public_flag = #{publicFlag}</if>
		<if test="configStatus != null"> and config_status = #{configStatus}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="configKey != null"> and config_key = #{configKey}</if>
		<if test="configName != null"> and config_name = #{configName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketSiteConfig对象,以参数BasketSiteConfig对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketSiteConfigByObj" parameterType="com.zhs.model.BasketSiteConfig" resultMap="result_BasketSiteConfigMapper.xml">
		select
		<include refid="basket_site_config_Column" />
		from basket_site_config
		<where>
		<if test="configValue != null"> and config_value = #{configValue}</if>
		<if test="valueType != null"> and value_type = #{valueType}</if>
		<if test="groupCode != null"> and group_code = #{groupCode}</if>
		<if test="publicFlag != null"> and public_flag = #{publicFlag}</if>
		<if test="configStatus != null"> and config_status = #{configStatus}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="configKey != null"> and config_key = #{configKey}</if>
		<if test="configName != null"> and config_name = #{configName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketSiteConfig插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketSiteConfig" parameterType="com.zhs.model.BasketSiteConfig">
		insert into 
		basket_site_config (id,config_key,config_name,config_value,value_type,group_code,public_flag,config_status,remark,create_time,update_time,is_delete) 
		values(#{id},#{configKey},#{configName},#{configValue},#{valueType},#{groupCode},#{publicFlag},#{configStatus},#{remark},#{createTime},#{updateTime},#{isDelete})
	</insert>

	<!-- 将BasketSiteConfig中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketSiteConfig" parameterType="com.zhs.model.BasketSiteConfig">
		insert into basket_site_config
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="configKey != null">config_key,</if>
			<if test="configName != null">config_name,</if>
			<if test="configValue != null">config_value,</if>
			<if test="valueType != null">value_type,</if>
			<if test="groupCode != null">group_code,</if>
			<if test="publicFlag != null">public_flag,</if>
			<if test="configStatus != null">config_status,</if>
			<if test="remark != null">remark,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="configKey != null">#{configKey},</if>
			<if test="configName != null">#{configName},</if>
			<if test="configValue != null">#{configValue},</if>
			<if test="valueType != null">#{valueType},</if>
			<if test="groupCode != null">#{groupCode},</if>
			<if test="publicFlag != null">#{publicFlag},</if>
