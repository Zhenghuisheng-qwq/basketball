<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketFavoriteDao">
	<resultMap id="result_BasketFavoriteMapper.xml" type="com.zhs.model.BasketFavorite">
		<id column="id" property="id" />
		<result column="member_id" property="memberId" />
		<result column="target_type" property="targetType" />
		<result column="target_id" property="targetId" />
		<result column="favorite_time" property="favoriteTime" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<!-- 数据库中表名为:basket_favorite的列名 -->
	<sql id="basket_favorite_Column">
		id,member_id,target_type,target_id,favorite_time,create_time,update_time,is_delete
	</sql>

	<!-- 通过BasketFavorite的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketFavoriteById" parameterType="Long" resultMap="result_BasketFavoriteMapper.xml">
		select
		<include refid="basket_favorite_Column" />
		from basket_favorite
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketFavorite对象,以参数BasketFavorite对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketFavoriteObjSingle" parameterType="com.zhs.model.BasketFavorite" resultMap="result_BasketFavoriteMapper.xml">
		select
		<include refid="basket_favorite_Column" />
		from basket_favorite
		<where>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="memberId != null"> and member_id = #{memberId}</if>
		<if test="targetType != null"> and target_type = #{targetType}</if>
		<if test="targetId != null"> and target_id = #{targetId}</if>
		<if test="favoriteTime != null"> and favorite_time = #{favoriteTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketFavorite对象,以参数BasketFavorite对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketFavoriteByObj" parameterType="com.zhs.model.BasketFavorite" resultMap="result_BasketFavoriteMapper.xml">
		select
		<include refid="basket_favorite_Column" />
		from basket_favorite
		<where>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="memberId != null"> and member_id = #{memberId}</if>
		<if test="targetType != null"> and target_type = #{targetType}</if>
		<if test="targetId != null"> and target_id = #{targetId}</if>
		<if test="favoriteTime != null"> and favorite_time = #{favoriteTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketFavorite插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketFavorite" parameterType="com.zhs.model.BasketFavorite">
		insert into 
		basket_favorite (id,member_id,target_type,target_id,favorite_time,create_time,update_time,is_delete) 
		values(#{id},#{memberId},#{targetType},#{targetId},#{favoriteTime},#{createTime},#{updateTime},#{isDelete})
	</insert>

	<!-- 将BasketFavorite中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketFavorite" parameterType="com.zhs.model.BasketFavorite">
		insert into basket_favorite
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="memberId != null">member_id,</if>
			<if test="targetType != null">target_type,</if>
			<if test="targetId != null">target_id,</if>
			<if test="favoriteTime != null">favorite_time,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="memberId != null">#{memberId},</if>
			<if test="targetType != null">#{targetType},</if>
			<if test="targetId != null">#{targetId},</if>
			<if test="favoriteTime != null">#{favoriteTime},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<!-- 将BasketFavorite批量插入到对应数据库的表中 -->
	<insert id="insertBasketFavoriteByBatch" parameterType="ArrayList">
		insert into basket_favorite(id,member_id,target_type,target_id,favorite_time,create_time,update_time,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{memberId},#{targetType},#{targetId},#{favoriteTime},#{createTime},#{updateTime},#{isDelete})
		</foreach>
	</insert>
	
	<!-- 通过BasketFavorite的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketFavoriteById" parameterType="Long">
		delete from basket_favorite
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketFavorite的id将BasketFavorite的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketFavoriteById" parameterType="com.zhs.model.BasketFavorite"> 
		update basket_favorite set
		<set>
			member_id = #{memberId} , 
			target_type = #{targetType} , 
			target_id = #{targetId} , 
			favorite_time = #{favoriteTime} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
			is_delete = #{isDelete} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketFavorite的id将BasketFavorite中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketFavoriteById" parameterType="com.zhs.model.BasketFavorite">
		update basket_favorite
		<set>
					<if test="memberId != null">member_id = #{memberId},</if>
					<if test="targetType != null">target_type = #{targetType},</if>
					<if test="targetId != null">target_id = #{targetId},</if>
					<if test="favoriteTime != null">favorite_time = #{favoriteTime},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
					<if test="isDelete != null">is_delete = #{isDelete},</if>
		</set>
		where id = #{id}
	</update>

</mapper>