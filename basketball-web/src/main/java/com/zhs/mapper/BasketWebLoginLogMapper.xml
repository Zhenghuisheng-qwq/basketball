<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketWebLoginLogDao">
	<resultMap id="result_BasketWebLoginLogMapper.xml" type="com.zhs.model.BasketWebLoginLog">
		<id column="id" property="id" />
		<result column="web_user_id" property="webUserId" />
		<result column="email" property="email" />
		<result column="login_ip" property="loginIp" />
		<result column="browser" property="browser" />
		<result column="os_name" property="osName" />
		<result column="login_status" property="loginStatus" />
		<result column="login_msg" property="loginMsg" />
		<result column="login_time" property="loginTime" />
	</resultMap>
	<!-- 数据库中表名为:basket_web_login_log的列名 -->
	<sql id="basket_web_login_log_Column">
		id,web_user_id,email,login_ip,browser,os_name,login_status,login_msg,login_time
	</sql>

	<!-- 通过BasketWebLoginLog的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketWebLoginLogById" parameterType="Long" resultMap="result_BasketWebLoginLogMapper.xml">
		select
		<include refid="basket_web_login_log_Column" />
		from basket_web_login_log
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketWebLoginLog对象,以参数BasketWebLoginLog对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketWebLoginLogObjSingle" parameterType="com.zhs.model.BasketWebLoginLog" resultMap="result_BasketWebLoginLogMapper.xml">
		select
		<include refid="basket_web_login_log_Column" />
		from basket_web_login_log
		<where>
		<if test="webUserId != null"> and web_user_id = #{webUserId}</if>
		<if test="email != null"> and email = #{email}</if>
		<if test="loginIp != null"> and login_ip = #{loginIp}</if>
		<if test="browser != null"> and browser = #{browser}</if>
		<if test="osName != null"> and os_name = #{osName}</if>
		<if test="loginStatus != null"> and login_status = #{loginStatus}</if>
		<if test="loginMsg != null"> and login_msg = #{loginMsg}</if>
		<if test="loginTime != null"> and login_time = #{loginTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketWebLoginLog对象,以参数BasketWebLoginLog对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketWebLoginLogByObj" parameterType="com.zhs.model.BasketWebLoginLog" resultMap="result_BasketWebLoginLogMapper.xml">
		select
		<include refid="basket_web_login_log_Column" />
		from basket_web_login_log
		<where>
		<if test="webUserId != null"> and web_user_id = #{webUserId}</if>
		<if test="email != null"> and email = #{email}</if>
		<if test="loginIp != null"> and login_ip = #{loginIp}</if>
		<if test="browser != null"> and browser = #{browser}</if>
		<if test="osName != null"> and os_name = #{osName}</if>
		<if test="loginStatus != null"> and login_status = #{loginStatus}</if>
		<if test="loginMsg != null"> and login_msg = #{loginMsg}</if>
		<if test="loginTime != null"> and login_time = #{loginTime}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketWebLoginLog插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketWebLoginLog" parameterType="com.zhs.model.BasketWebLoginLog">
		insert into 
		basket_web_login_log (id,web_user_id,email,login_ip,browser,os_name,login_status,login_msg,login_time) 
		values(#{id},#{webUserId},#{email},#{loginIp},#{browser},#{osName},#{loginStatus},#{loginMsg},#{loginTime})
	</insert>

	<!-- 将BasketWebLoginLog中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketWebLoginLog" parameterType="com.zhs.model.BasketWebLoginLog">
		insert into basket_web_login_log
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="webUserId != null">web_user_id,</if>
			<if test="email != null">email,</if>
			<if test="loginIp != null">login_ip,</if>
			<if test="browser != null">browser,</if>
			<if test="osName != null">os_name,</if>
			<if test="loginStatus != null">login_status,</if>
			<if test="loginMsg != null">login_msg,</if>
			<if test="loginTime != null">login_time,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="webUserId != null">#{webUserId},</if>
			<if test="email != null">#{email},</if>
			<if test="loginIp != null">#{loginIp},</if>
			<if test="browser != null">#{browser},</if>
			<if test="osName != null">#{osName},</if>
			<if test="loginStatus != null">#{loginStatus},</if>
			<if test="loginMsg != null">#{loginMsg},</if>
			<if test="loginTime != null">#{loginTime},</if>
		</trim>
	</insert>

	<!-- 将BasketWebLoginLog批量插入到对应数据库的表中 -->
	<insert id="insertBasketWebLoginLogByBatch" parameterType="ArrayList">
		insert into basket_web_login_log(id,web_user_id,email,login_ip,browser,os_name,login_status,login_msg,login_time) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{webUserId},#{email},#{loginIp},#{browser},#{osName},#{loginStatus},#{loginMsg},#{loginTime})
		</foreach>
	</insert>
	
	<!-- 通过BasketWebLoginLog的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketWebLoginLogById" parameterType="Long">
		delete from basket_web_login_log
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketWebLoginLog的id将BasketWebLoginLog的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketWebLoginLogById" parameterType="com.zhs.model.BasketWebLoginLog"> 
		update basket_web_login_log set
		<set>
			web_user_id = #{webUserId} , 
			email = #{email} , 
			login_ip = #{loginIp} , 
			browser = #{browser} , 
			os_name = #{osName} , 
			login_status = #{loginStatus} , 
			login_msg = #{loginMsg} , 
			login_time = #{loginTime} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketWebLoginLog的id将BasketWebLoginLog中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketWebLoginLogById" parameterType="com.zhs.model.BasketWebLoginLog">
		update basket_web_login_log
		<set>
					<if test="webUserId != null">web_user_id = #{webUserId},</if>
					<if test="email != null">email = #{email},</if>
					<if test="loginIp != null">login_ip = #{loginIp},</if>
					<if test="browser != null">browser = #{browser},</if>
					<if test="osName != null">os_name = #{osName},</if>
					<if test="loginStatus != null">login_status = #{loginStatus},</if>
					<if test="loginMsg != null">login_msg = #{loginMsg},</if>
					<if test="loginTime != null">login_time = #{loginTime},</if>
		</set>
		where id = #{id}
	</update>

</mapper>