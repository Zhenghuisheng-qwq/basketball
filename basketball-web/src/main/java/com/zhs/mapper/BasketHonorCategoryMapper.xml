<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketHonorCategoryDao">
	<resultMap id="result_BasketHonorCategoryMapper.xml" type="com.zhs.model.BasketHonorCategory">
		<id column="id" property="id" />
		<result column="honor_code" property="honorCode" />
		<result column="honor_name" property="honorName" />
		<result column="honor_scope" property="honorScope" />
		<result column="recipient_type" property="recipientType" />
		<result column="description" property="description" />
		<result column="display_order" property="displayOrder" />
		<result column="honor_status" property="honorStatus" />
		<result column="create_time" property="createTime" />
		<result column="update_time" property="updateTime" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<!-- 数据库中表名为:basket_honor_category的列名 -->
	<sql id="basket_honor_category_Column">
		id,honor_code,honor_name,honor_scope,recipient_type,description,display_order,honor_status,create_time,update_time,is_delete
	</sql>

	<!-- 通过BasketHonorCategory的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketHonorCategoryById" parameterType="Long" resultMap="result_BasketHonorCategoryMapper.xml">
		select
		<include refid="basket_honor_category_Column" />
		from basket_honor_category
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketHonorCategory对象,以参数BasketHonorCategory对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketHonorCategoryObjSingle" parameterType="com.zhs.model.BasketHonorCategory" resultMap="result_BasketHonorCategoryMapper.xml">
		select
		<include refid="basket_honor_category_Column" />
		from basket_honor_category
		<where>
		<if test="description != null"> and description = #{description}</if>
		<if test="displayOrder != null"> and display_order = #{displayOrder}</if>
		<if test="honorStatus != null"> and honor_status = #{honorStatus}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="honorCode != null"> and honor_code = #{honorCode}</if>
		<if test="honorName != null"> and honor_name = #{honorName}</if>
		<if test="honorScope != null"> and honor_scope = #{honorScope}</if>
		<if test="recipientType != null"> and recipient_type = #{recipientType}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketHonorCategory对象,以参数BasketHonorCategory对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketHonorCategoryByObj" parameterType="com.zhs.model.BasketHonorCategory" resultMap="result_BasketHonorCategoryMapper.xml">
		select
		<include refid="basket_honor_category_Column" />
		from basket_honor_category
		<where>
		<if test="description != null"> and description = #{description}</if>
		<if test="displayOrder != null"> and display_order = #{displayOrder}</if>
		<if test="honorStatus != null"> and honor_status = #{honorStatus}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="honorCode != null"> and honor_code = #{honorCode}</if>
		<if test="honorName != null"> and honor_name = #{honorName}</if>
		<if test="honorScope != null"> and honor_scope = #{honorScope}</if>
		<if test="recipientType != null"> and recipient_type = #{recipientType}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketHonorCategory插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketHonorCategory" parameterType="com.zhs.model.BasketHonorCategory">
		insert into 
		basket_honor_category (id,honor_code,honor_name,honor_scope,recipient_type,description,display_order,honor_status,create_time,update_time,is_delete) 
		values(#{id},#{honorCode},#{honorName},#{honorScope},#{recipientType},#{description},#{displayOrder},#{honorStatus},#{createTime},#{updateTime},#{isDelete})
	</insert>

	<!-- 将BasketHonorCategory中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketHonorCategory" parameterType="com.zhs.model.BasketHonorCategory">
		insert into basket_honor_category
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="honorCode != null">honor_code,</if>
			<if test="honorName != null">honor_name,</if>
			<if test="honorScope != null">honor_scope,</if>
			<if test="recipientType != null">recipient_type,</if>
			<if test="description != null">description,</if>
			<if test="displayOrder != null">display_order,</if>
			<if test="honorStatus != null">honor_status,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="honorCode != null">#{honorCode},</if>
			<if test="honorName != null">#{honorName},</if>
			<if test="honorScope != null">#{honorScope},</if>
			<if test="recipientType != null">#{recipientType},</if>
			<if test="description != null">#{description},</if>
			<if test="displayOrder != null">#{displayOrder},</if>
			<if test="honorStatus != null">#{honorStatus},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<!-- 将BasketHonorCategory批量插入到对应数据库的表中 -->
	<insert id="insertBasketHonorCategoryByBatch" parameterType="ArrayList">
		insert into basket_honor_category(id,honor_code,honor_name,honor_scope,recipient_type,description,display_order,honor_status,create_time,update_time,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{honorCode},#{honorName},#{honorScope},#{recipientType},#{description},#{displayOrder},#{honorStatus},#{createTime},#{updateTime},#{isDelete})
		</foreach>
	</insert>
	
	<!-- 通过BasketHonorCategory的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketHonorCategoryById" parameterType="Long">
		delete from basket_honor_category
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketHonorCategory的id将BasketHonorCategory的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketHonorCategoryById" parameterType="com.zhs.model.BasketHonorCategory"> 
		update basket_honor_category set
		<set>
			honor_code = #{honorCode} , 
			honor_name = #{honorName} , 
			honor_scope = #{honorScope} , 
			recipient_type = #{recipientType} , 
			description = #{description} , 
			display_order = #{displayOrder} , 
			honor_status = #{honorStatus} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
			is_delete = #{isDelete} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketHonorCategory的id将BasketHonorCategory中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketHonorCategoryById" parameterType="com.zhs.model.BasketHonorCategory">
		update basket_honor_category
		<set>
					<if test="honorCode != null">honor_code = #{honorCode},</if>
					<if test="honorName != null">honor_name = #{honorName},</if>
					<if test="honorScope != null">honor_scope = #{honorScope},</if>
					<if test="recipientType != null">recipient_type = #{recipientType},</if>
					<if test="description != null">description = #{description},</if>
					<if test="displayOrder != null">display_order = #{displayOrder},</if>
					<if test="honorStatus != null">honor_status = #{honorStatus},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
					<if test="isDelete != null">is_delete = #{isDelete},</if>
		</set>
		where id = #{id}
	</update>

</mapper>