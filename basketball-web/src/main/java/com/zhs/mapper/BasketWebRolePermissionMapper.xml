<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketWebRolePermissionDao">
	<resultMap id="result_BasketWebRolePermissionMapper.xml" type="com.zhs.model.BasketWebRolePermission">
		<id column="role_id" property="id" />
		<result column="permission_id" property="permissionId" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<sql id="basket_web_role_permission_Column">
		role_id,permission_id,is_delete
	</sql>

	<select id="selectBasketWebRolePermissionById" parameterType="Long" resultMap="result_BasketWebRolePermissionMapper.xml">
		select
		<include refid="basket_web_role_permission_Column" />
		from basket_web_role_permission
		where role_id = #{id}
	</select>

	<select id="selectBasketWebRolePermissionObjSingle" parameterType="com.zhs.model.BasketWebRolePermission" resultMap="result_BasketWebRolePermissionMapper.xml">
		select
		<include refid="basket_web_role_permission_Column" />
		from basket_web_role_permission
		<where>
		<if test="id != null"> and role_id = #{id}</if>
		<if test="permissionId != null"> and permission_id = #{permissionId} </if>
		</where>
		LIMIT 1
	</select>

	<select id="selectBasketWebRolePermissionByObj" parameterType="com.zhs.model.BasketWebRolePermission" resultMap="result_BasketWebRolePermissionMapper.xml">
		select
		<include refid="basket_web_role_permission_Column" />
		from basket_web_role_permission
		<where>
		<if test="id != null"> and role_id = #{id}</if>
		<if test="permissionId != null"> and permission_id = #{permissionId} </if>
		</where>
	</select>

	<insert id="insertBasketWebRolePermission" parameterType="com.zhs.model.BasketWebRolePermission">
		insert into
		basket_web_role_permission (role_id,permission_id,is_delete)
		values(#{id},#{permissionId},#{isDelete})
	</insert>

	<insert id="insertNotNullBasketWebRolePermission" parameterType="com.zhs.model.BasketWebRolePermission">
		insert into basket_web_role_permission
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">role_id,</if>
			<if test="permissionId != null">permission_id,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="permissionId != null">#{permissionId},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<insert id="insertBasketWebRolePermissionByBatch" parameterType="ArrayList">
		insert into basket_web_role_permission(role_id,permission_id,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{item.id},#{item.permissionId},#{item.isDelete})
		</foreach>
	</insert>

	<delete id="deleteBasketWebRolePermissionById" parameterType="Long">
		delete from basket_web_role_permission
		where role_id = #{id}
	</delete>

	<update id="updateBasketWebRolePermissionById" parameterType="com.zhs.model.BasketWebRolePermission">
		update basket_web_role_permission set
		<set>
			permission_id = #{permissionId},
			is_delete = #{isDelete},
		</set>
		where role_id = #{id}
	</update>

	<update id="updateNotNullBasketWebRolePermissionById" parameterType="com.zhs.model.BasketWebRolePermission">
		update basket_web_role_permission
		<set>
			<if test="permissionId != null">permission_id = #{permissionId},</if>
			<if test="isDelete != null">is_delete = #{isDelete},</if>
		</set>
		where role_id = #{id}
	</update>

</mapper>
