<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketRoundDao">
	<resultMap id="result_BasketRoundMapper.xml" type="com.zhs.model.BasketRound">
		<id column="id" property="id" />
		<result column="tournament_id" property="tournamentId" />
		<result column="round_name" property="roundName" />
		<result column="round_type" property="roundType" />
		<result column="round_sort" property="roundSort" />
		<result column="round_status" property="roundStatus" />
		<result column="create_by" property="createBy" />
		<result column="create_time" property="createTime" />
		<result column="update_by" property="updateBy" />
		<result column="update_time" property="updateTime" />
	</resultMap>
	<!-- 数据库中表名为:basket_round的列名 -->
	<sql id="basket_round_Column">
		id,tournament_id,round_name,round_type,round_sort,round_status,create_by,create_time,update_by,update_time
	</sql>

	<!-- 通过BasketRound的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketRoundById" parameterType="Long" resultMap="result_BasketRoundMapper.xml">
		select
		<include refid="basket_round_Column" />
		from basket_round
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketRound对象,以参数BasketRound对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketRoundObjSingle" parameterType="com.zhs.model.BasketRound" resultMap="result_BasketRoundMapper.xml">
		select
		<include refid="basket_round_Column" />
		from basket_round
		<where>
		<if test="roundType != null"> and round_type = #{roundType}</if>
		<if test="roundSort != null"> and round_sort = #{roundSort}</if>
		<if test="roundStatus != null"> and round_status = #{roundStatus}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="tournamentId != null"> and tournament_id = #{tournamentId}</if>
		<if test="roundName != null"> and round_name = #{roundName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketRound对象,以参数BasketRound对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketRoundByObj" parameterType="com.zhs.model.BasketRound" resultMap="result_BasketRoundMapper.xml">
		select
		<include refid="basket_round_Column" />
		from basket_round
		<where>
		<if test="roundType != null"> and round_type = #{roundType}</if>
		<if test="roundSort != null"> and round_sort = #{roundSort}</if>
		<if test="roundStatus != null"> and round_status = #{roundStatus}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="tournamentId != null"> and tournament_id = #{tournamentId}</if>
		<if test="roundName != null"> and round_name = #{roundName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketRound插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketRound" parameterType="com.zhs.model.BasketRound">
		insert into 
		basket_round (id,tournament_id,round_name,round_type,round_sort,round_status,create_by,create_time,update_by,update_time) 
		values(#{id},#{tournamentId},#{roundName},#{roundType},#{roundSort},#{roundStatus},#{createBy},#{createTime},#{updateBy},#{updateTime})
	</insert>

	<!-- 将BasketRound中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketRound" parameterType="com.zhs.model.BasketRound">
		insert into basket_round
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="tournamentId != null">tournament_id,</if>
			<if test="roundName != null">round_name,</if>
			<if test="roundType != null">round_type,</if>
			<if test="roundSort != null">round_sort,</if>
			<if test="roundStatus != null">round_status,</if>
			<if test="createBy != null">create_by,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateBy != null">update_by,</if>
			<if test="updateTime != null">update_time,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="tournamentId != null">#{tournamentId},</if>
			<if test="roundName != null">#{roundName},</if>
			<if test="roundType != null">#{roundType},</if>
			<if test="roundSort != null">#{roundSort},</if>
			<if test="roundStatus != null">#{roundStatus},</if>
			<if test="createBy != null">#{createBy},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateBy != null">#{updateBy},</if>
			<if test="updateTime != null">#{updateTime},</if>
		</trim>
	</insert>

	<!-- 将BasketRound批量插入到对应数据库的表中 -->
	<insert id="insertBasketRoundByBatch" parameterType="ArrayList">
		insert into basket_round(id,tournament_id,round_name,round_type,round_sort,round_status,create_by,create_time,update_by,update_time) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{tournamentId},#{roundName},#{roundType},#{roundSort},#{roundStatus},#{createBy},#{createTime},#{updateBy},#{updateTime})
		</foreach>
	</insert>
	
	<!-- 通过BasketRound的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketRoundById" parameterType="Long">
		delete from basket_round
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketRound的id将BasketRound的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketRoundById" parameterType="com.zhs.model.BasketRound"> 
		update basket_round set
		<set>
			tournament_id = #{tournamentId} , 
			round_name = #{roundName} , 
			round_type = #{roundType} , 
			round_sort = #{roundSort} , 
			round_status = #{roundStatus} , 
			create_by = #{createBy} , 
			create_time = #{createTime} , 
			update_by = #{updateBy} , 
			update_time = #{updateTime} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketRound的id将BasketRound中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketRoundById" parameterType="com.zhs.model.BasketRound">
		update basket_round
		<set>
					<if test="tournamentId != null">tournament_id = #{tournamentId},</if>
					<if test="roundName != null">round_name = #{roundName},</if>
					<if test="roundType != null">round_type = #{roundType},</if>
					<if test="roundSort != null">round_sort = #{roundSort},</if>
					<if test="roundStatus != null">round_status = #{roundStatus},</if>
					<if test="createBy != null">create_by = #{createBy},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateBy != null">update_by = #{updateBy},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
		</set>
		where id = #{id}
	</update>

</mapper>