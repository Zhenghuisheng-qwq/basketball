<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketWebPermissionDao">
	<resultMap id="result_BasketWebPermissionMapper.xml" type="com.zhs.model.BasketWebPermission">
		<id column="id" property="id" />
		<result column="permission_code" property="permissionCode" />
		<result column="permission_name" property="permissionName" />
		<result column="module_name" property="moduleName" />
		<result column="permission_type" property="permissionType" />
		<result column="permission_status" property="permissionStatus" />
		<result column="create_by" property="createBy" />
		<result column="create_time" property="createTime" />
		<result column="update_by" property="updateBy" />
		<result column="update_time" property="updateTime" />
		<result column="remark" property="remark" />
	</resultMap>
	<!-- 数据库中表名为:basket_web_permission的列名 -->
	<sql id="basket_web_permission_Column">
		id,permission_code,permission_name,module_name,permission_type,permission_status,create_by,create_time,update_by,update_time,remark
	</sql>

	<!-- 通过BasketWebPermission的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketWebPermissionById" parameterType="Long" resultMap="result_BasketWebPermissionMapper.xml">
		select
		<include refid="basket_web_permission_Column" />
		from basket_web_permission
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketWebPermission对象,以参数BasketWebPermission对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketWebPermissionObjSingle" parameterType="com.zhs.model.BasketWebPermission" resultMap="result_BasketWebPermissionMapper.xml">
		select
		<include refid="basket_web_permission_Column" />
		from basket_web_permission
		<where>
		<if test="permissionType != null"> and permission_type = #{permissionType}</if>
		<if test="permissionStatus != null"> and permission_status = #{permissionStatus}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="permissionCode != null"> and permission_code = #{permissionCode}</if>
		<if test="permissionName != null"> and permission_name = #{permissionName}</if>
		<if test="moduleName != null"> and module_name = #{moduleName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketWebPermission对象,以参数BasketWebPermission对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketWebPermissionByObj" parameterType="com.zhs.model.BasketWebPermission" resultMap="result_BasketWebPermissionMapper.xml">
		select
		<include refid="basket_web_permission_Column" />
		from basket_web_permission
		<where>
		<if test="permissionType != null"> and permission_type = #{permissionType}</if>
		<if test="permissionStatus != null"> and permission_status = #{permissionStatus}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="permissionCode != null"> and permission_code = #{permissionCode}</if>
		<if test="permissionName != null"> and permission_name = #{permissionName}</if>
		<if test="moduleName != null"> and module_name = #{moduleName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketWebPermission插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketWebPermission" parameterType="com.zhs.model.BasketWebPermission">
		insert into 
		basket_web_permission (id,permission_code,permission_name,module_name,permission_type,permission_status,create_by,create_time,update_by,update_time,remark) 
		values(#{id},#{permissionCode},#{permissionName},#{moduleName},#{permissionType},#{permissionStatus},#{createBy},#{createTime},#{updateBy},#{updateTime},#{remark})
	</insert>

	<!-- 将BasketWebPermission中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketWebPermission" parameterType="com.zhs.model.BasketWebPermission">
		insert into basket_web_permission
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="permissionCode != null">permission_code,</if>
			<if test="permissionName != null">permission_name,</if>
			<if test="moduleName != null">module_name,</if>
			<if test="permissionType != null">permission_type,</if>
			<if test="permissionStatus != null">permission_status,</if>
			<if test="createBy != null">create_by,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateBy != null">update_by,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="remark != null">remark,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="permissionCode != null">#{permissionCode},</if>
			<if test="permissionName != null">#{permissionName},</if>
			<if test="moduleName != null">#{moduleName},</if>
			<if test="permissionType != null">#{permissionType},</if>
			<if test="permissionStatus != null">#{permissionStatus},</if>
			<if test="createBy != null">#{createBy},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateBy != null">#{updateBy},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="remark != null">#{remark},</if>
		</trim>
	</insert>

	<!-- 将BasketWebPermission批量插入到对应数据库的表中 -->
	<insert id="insertBasketWebPermissionByBatch" parameterType="ArrayList">
		insert into basket_web_permission(id,permission_code,permission_name,module_name,permission_type,permission_status,create_by,create_time,update_by,update_time,remark) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{permissionCode},#{permissionName},#{moduleName},#{permissionType},#{permissionStatus},#{createBy},#{createTime},#{updateBy},#{updateTime},#{remark})
		</foreach>
	</insert>
	
	<!-- 通过BasketWebPermission的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketWebPermissionById" parameterType="Long">
		delete from basket_web_permission
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketWebPermission的id将BasketWebPermission的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketWebPermissionById" parameterType="com.zhs.model.BasketWebPermission"> 
		update basket_web_permission set
		<set>
			permission_code = #{permissionCode} , 
			permission_name = #{permissionName} , 
			module_name = #{moduleName} , 
			permission_type = #{permissionType} , 
			permission_status = #{permissionStatus} , 
			create_by = #{createBy} , 
			create_time = #{createTime} , 
			update_by = #{updateBy} , 
			update_time = #{updateTime} , 
			remark = #{remark} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketWebPermission的id将BasketWebPermission中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketWebPermissionById" parameterType="com.zhs.model.BasketWebPermission">
		update basket_web_permission
		<set>
					<if test="permissionCode != null">permission_code = #{permissionCode},</if>
					<if test="permissionName != null">permission_name = #{permissionName},</if>
					<if test="moduleName != null">module_name = #{moduleName},</if>
					<if test="permissionType != null">permission_type = #{permissionType},</if>
					<if test="permissionStatus != null">permission_status = #{permissionStatus},</if>
					<if test="createBy != null">create_by = #{createBy},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateBy != null">update_by = #{updateBy},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
					<if test="remark != null">remark = #{remark},</if>
		</set>
		where id = #{id}
	</update>

</mapper>