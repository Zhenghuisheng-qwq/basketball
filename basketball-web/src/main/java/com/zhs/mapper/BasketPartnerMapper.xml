		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="isDelete != null"> and is_delete = #{isDelete}</if>
		<if test="partnerName != null"> and partner_name = #{partnerName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketPartner对象,以参数BasketPartner对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketPartnerByObj" parameterType="com.zhs.model.BasketPartner" resultMap="result_BasketPartnerMapper.xml">
		select
		<include refid="basket_partner_Column" />
		from basket_partner
		<where>
		<if test="logoFileId != null"> and logo_file_id = #{logoFileId}</if>
		<if test="websiteUrl != null"> and website_url = #{websiteUrl}</if>
		<if test="partnerType != null"> and partner_type = #{partnerType}</if>
		<if test="cooperationStartDate != null"> and cooperation_start_date = #{cooperationStartDate}</if>
		<if test="cooperationEndDate != null"> and cooperation_end_date = #{cooperationEndDate}</if>
