	<!-- 数据库中表名为:basket_partner的列名 -->
	<sql id="basket_partner_Column">
		id,partner_name,logo_file_id,website_url,partner_type,cooperation_start_date,cooperation_end_date,partner_status,sort_no,remark,create_time,update_time,is_delete
	</sql>

	<!-- 通过BasketPartner的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketPartnerById" parameterType="Long" resultMap="result_BasketPartnerMapper.xml">
		select
		<include refid="basket_partner_Column" />
		from basket_partner
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketPartner对象,以参数BasketPartner对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketPartnerObjSingle" parameterType="com.zhs.model.BasketPartner" resultMap="result_BasketPartnerMapper.xml">
		select
		<include refid="basket_partner_Column" />
		from basket_partner
		<where>
		<if test="logoFileId != null"> and logo_file_id = #{logoFileId}</if>
		<if test="websiteUrl != null"> and website_url = #{websiteUrl}</if>
		<if test="partnerType != null"> and partner_type = #{partnerType}</if>
		<if test="cooperationStartDate != null"> and cooperation_start_date = #{cooperationStartDate}</if>
		<if test="cooperationEndDate != null"> and cooperation_end_date = #{cooperationEndDate}</if>
		<if test="partnerStatus != null"> and partner_status = #{partnerStatus}</if>
