	</insert>

	<!-- 将BasketPartner批量插入到对应数据库的表中 -->
	<insert id="insertBasketPartnerByBatch" parameterType="ArrayList">
		insert into basket_partner(id,partner_name,logo_file_id,website_url,partner_type,cooperation_start_date,cooperation_end_date,partner_status,sort_no,remark,create_time,update_time,is_delete) values
