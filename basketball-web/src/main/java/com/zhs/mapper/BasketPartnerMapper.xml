<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketPartnerDao">
	<resultMap id="result_BasketPartnerMapper.xml" type="com.zhs.model.BasketPartner">
		<id column="id" property="id" />
		<result column="partner_name" property="partnerName" />
		<result column="logo_file_id" property="logoFileId" />
		<result column="website_url" property="websiteUrl" />
		<result column="partner_type" property="partnerType" />
		<result column="cooperation_start_date" property="cooperationStartDate" />
		<result column="cooperation_end_date" property="cooperationEndDate" />
		<result column="partner_status" property="partnerStatus" />
		<result column="sort_no" property="sortNo" />
