			<if test="createTime != null">#{createTime},</if>
			<if test="remark != null">#{remark},</if>
		</trim>
	</insert>

	<!-- 将BasketFileResource批量插入到对应数据库的表中 -->
	<insert id="insertBasketFileResourceByBatch" parameterType="ArrayList">
		insert into basket_file_resource(id,file_name,file_path,file_url,file_type,file_size,business_type,business_id,upload_user_id,upload_time,file_status,create_by,create_time,remark) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{fileName},#{filePath},#{fileUrl},#{fileType},#{fileSize},#{businessType},#{businessId},#{uploadUserId},#{uploadTime},#{fileStatus},#{createBy},#{createTime},#{remark})
		</foreach>
