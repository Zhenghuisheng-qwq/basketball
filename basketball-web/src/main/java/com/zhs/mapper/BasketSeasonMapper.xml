<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketSeasonDao">
	<resultMap id="result_BasketSeasonMapper.xml" type="com.zhs.model.BasketSeason">
		<id column="id" property="id" />
		<result column="season_no" property="seasonNo" />
		<result column="season_name" property="seasonName" />
		<result column="start_time" property="startTime" />
		<result column="end_time" property="endTime" />
		<result column="current_flag" property="currentFlag" />
		<result column="archive_flag" property="archiveFlag" />
		<result column="season_status" property="seasonStatus" />
		<result column="sort_no" property="sortNo" />
		<result column="create_by" property="createBy" />
		<result column="create_time" property="createTime" />
		<result column="update_by" property="updateBy" />
		<result column="update_time" property="updateTime" />
		<result column="remark" property="remark" />
	</resultMap>
	<!-- 数据库中表名为:basket_season的列名 -->
	<sql id="basket_season_Column">
		id,season_no,season_name,start_time,end_time,current_flag,archive_flag,season_status,sort_no,create_by,create_time,update_by,update_time,remark
	</sql>

	<!-- 通过BasketSeason的id获得对应数据库中表的数据对象 -->
	<select id="selectBasketSeasonById" parameterType="Long" resultMap="result_BasketSeasonMapper.xml">
		select
		<include refid="basket_season_Column" />
		from basket_season
		where id = #{id}
	</select>
	
	<!-- 获得一个BasketSeason对象,以参数BasketSeason对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketSeasonObjSingle" parameterType="com.zhs.model.BasketSeason" resultMap="result_BasketSeasonMapper.xml">
		select
		<include refid="basket_season_Column" />
		from basket_season
		<where>
		<if test="startTime != null"> and start_time = #{startTime}</if>
		<if test="endTime != null"> and end_time = #{endTime}</if>
		<if test="currentFlag != null"> and current_flag = #{currentFlag}</if>
		<if test="archiveFlag != null"> and archive_flag = #{archiveFlag}</if>
		<if test="seasonStatus != null"> and season_status = #{seasonStatus}</if>
		<if test="sortNo != null"> and sort_no = #{sortNo}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="seasonNo != null"> and season_no = #{seasonNo}</if>
		<if test="seasonName != null"> and season_name = #{seasonName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
		LIMIT 1
	</select>
	
	<!-- 获得BasketSeason对象,以参数BasketSeason对象中不为空的属性作为条件进行查询 -->
	<select id="selectBasketSeasonByObj" parameterType="com.zhs.model.BasketSeason" resultMap="result_BasketSeasonMapper.xml">
		select
		<include refid="basket_season_Column" />
		from basket_season
		<where>
		<if test="startTime != null"> and start_time = #{startTime}</if>
		<if test="endTime != null"> and end_time = #{endTime}</if>
		<if test="currentFlag != null"> and current_flag = #{currentFlag}</if>
		<if test="archiveFlag != null"> and archive_flag = #{archiveFlag}</if>
		<if test="seasonStatus != null"> and season_status = #{seasonStatus}</if>
		<if test="sortNo != null"> and sort_no = #{sortNo}</if>
		<if test="createBy != null"> and create_by = #{createBy}</if>
		<if test="createTime != null"> and create_time = #{createTime}</if>
		<if test="updateBy != null"> and update_by = #{updateBy}</if>
		<if test="updateTime != null"> and update_time = #{updateTime}</if>
		<if test="remark != null"> and remark = #{remark}</if>
		<if test="seasonNo != null"> and season_no = #{seasonNo}</if>
		<if test="seasonName != null"> and season_name = #{seasonName}</if>
		<if test="id != null"> and id = #{id} </if>
		</where>
	</select>

	<!-- 将BasketSeason插入到对应数据库的表中,包括属性值为null的数据 -->
	<insert id="insertBasketSeason" parameterType="com.zhs.model.BasketSeason">
		insert into 
		basket_season (id,season_no,season_name,start_time,end_time,current_flag,archive_flag,season_status,sort_no,create_by,create_time,update_by,update_time,remark) 
		values(#{id},#{seasonNo},#{seasonName},#{startTime},#{endTime},#{currentFlag},#{archiveFlag},#{seasonStatus},#{sortNo},#{createBy},#{createTime},#{updateBy},#{updateTime},#{remark})
	</insert>

	<!-- 将BasketSeason中属性值不为null的数据,插入到对应数据库的表中 -->
	<insert id="insertNotNullBasketSeason" parameterType="com.zhs.model.BasketSeason">
		insert into basket_season
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">id,</if>
			<if test="seasonNo != null">season_no,</if>
			<if test="seasonName != null">season_name,</if>
			<if test="startTime != null">start_time,</if>
			<if test="endTime != null">end_time,</if>
			<if test="currentFlag != null">current_flag,</if>
			<if test="archiveFlag != null">archive_flag,</if>
			<if test="seasonStatus != null">season_status,</if>
			<if test="sortNo != null">sort_no,</if>
			<if test="createBy != null">create_by,</if>
			<if test="createTime != null">create_time,</if>
			<if test="updateBy != null">update_by,</if>
			<if test="updateTime != null">update_time,</if>
			<if test="remark != null">remark,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="seasonNo != null">#{seasonNo},</if>
			<if test="seasonName != null">#{seasonName},</if>
			<if test="startTime != null">#{startTime},</if>
			<if test="endTime != null">#{endTime},</if>
			<if test="currentFlag != null">#{currentFlag},</if>
			<if test="archiveFlag != null">#{archiveFlag},</if>
			<if test="seasonStatus != null">#{seasonStatus},</if>
			<if test="sortNo != null">#{sortNo},</if>
			<if test="createBy != null">#{createBy},</if>
			<if test="createTime != null">#{createTime},</if>
			<if test="updateBy != null">#{updateBy},</if>
			<if test="updateTime != null">#{updateTime},</if>
			<if test="remark != null">#{remark},</if>
		</trim>
	</insert>

	<!-- 将BasketSeason批量插入到对应数据库的表中 -->
	<insert id="insertBasketSeasonByBatch" parameterType="ArrayList">
		insert into basket_season(id,season_no,season_name,start_time,end_time,current_flag,archive_flag,season_status,sort_no,create_by,create_time,update_by,update_time,remark) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{id},#{seasonNo},#{seasonName},#{startTime},#{endTime},#{currentFlag},#{archiveFlag},#{seasonStatus},#{sortNo},#{createBy},#{createTime},#{updateBy},#{updateTime},#{remark})
		</foreach>
	</insert>
	
	<!-- 通过BasketSeason的id将数据库表中对应的数据删除 -->
	<delete id="deleteBasketSeasonById" parameterType="Long">
		delete from basket_season
		where  id  =  #{id}
	</delete>



	<!-- 通过BasketSeason的id将BasketSeason的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketSeasonById" parameterType="com.zhs.model.BasketSeason"> 
		update basket_season set
		<set>
			season_no = #{seasonNo} , 
			season_name = #{seasonName} , 
			start_time = #{startTime} , 
			end_time = #{endTime} , 
			current_flag = #{currentFlag} , 
			archive_flag = #{archiveFlag} , 
			season_status = #{seasonStatus} , 
			sort_no = #{sortNo} , 
			create_by = #{createBy} , 
			create_time = #{createTime} , 
			update_by = #{updateBy} , 
			update_time = #{updateTime} , 
			remark = #{remark} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketSeason的id将BasketSeason中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketSeasonById" parameterType="com.zhs.model.BasketSeason">
		update basket_season
		<set>
					<if test="seasonNo != null">season_no = #{seasonNo},</if>
					<if test="seasonName != null">season_name = #{seasonName},</if>
					<if test="startTime != null">start_time = #{startTime},</if>
					<if test="endTime != null">end_time = #{endTime},</if>
					<if test="currentFlag != null">current_flag = #{currentFlag},</if>
					<if test="archiveFlag != null">archive_flag = #{archiveFlag},</if>
					<if test="seasonStatus != null">season_status = #{seasonStatus},</if>
					<if test="sortNo != null">sort_no = #{sortNo},</if>
					<if test="createBy != null">create_by = #{createBy},</if>
					<if test="createTime != null">create_time = #{createTime},</if>
					<if test="updateBy != null">update_by = #{updateBy},</if>
					<if test="updateTime != null">update_time = #{updateTime},</if>
					<if test="remark != null">remark = #{remark},</if>
		</set>
		where id = #{id}
	</update>

</mapper>