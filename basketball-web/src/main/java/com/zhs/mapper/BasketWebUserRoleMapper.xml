<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhs.dao.BasketWebUserRoleDao">
	<resultMap id="result_BasketWebUserRoleMapper.xml" type="com.zhs.model.BasketWebUserRole">
		<id column="web_user_id" property="id" />
		<result column="role_id" property="roleId" />
		<result column="is_delete" property="isDelete" />
	</resultMap>
	<sql id="basket_web_user_role_Column">
		web_user_id,role_id,is_delete
	</sql>

	<select id="selectBasketWebUserRoleById" parameterType="Long" resultMap="result_BasketWebUserRoleMapper.xml">
		select
		<include refid="basket_web_user_role_Column" />
		from basket_web_user_role
		where web_user_id = #{id}
	</select>

	<select id="selectBasketWebUserRoleObjSingle" parameterType="com.zhs.model.BasketWebUserRole" resultMap="result_BasketWebUserRoleMapper.xml">
		select
		<include refid="basket_web_user_role_Column" />
		from basket_web_user_role
		<where>
		<if test="id != null"> and web_user_id = #{id}</if>
		<if test="roleId != null"> and role_id = #{roleId} </if>
		</where>
		LIMIT 1
	</select>

	<select id="selectBasketWebUserRoleByObj" parameterType="com.zhs.model.BasketWebUserRole" resultMap="result_BasketWebUserRoleMapper.xml">
		select
		<include refid="basket_web_user_role_Column" />
		from basket_web_user_role
		<where>
		<if test="id != null"> and web_user_id = #{id}</if>
		<if test="roleId != null"> and role_id = #{roleId} </if>
		</where>
	</select>

	<insert id="insertBasketWebUserRole" parameterType="com.zhs.model.BasketWebUserRole">
		insert into
		basket_web_user_role (web_user_id,role_id,is_delete)
		values(#{id},#{roleId},#{isDelete})
	</insert>

	<insert id="insertNotNullBasketWebUserRole" parameterType="com.zhs.model.BasketWebUserRole">
		insert into basket_web_user_role
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="id != null">web_user_id,</if>
			<if test="roleId != null">role_id,</if>
			<if test="isDelete != null">is_delete,</if>
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="id != null">#{id},</if>
			<if test="roleId != null">#{roleId},</if>
			<if test="isDelete != null">#{isDelete},</if>
		</trim>
	</insert>

	<insert id="insertBasketWebUserRoleByBatch" parameterType="ArrayList">
		insert into basket_web_user_role(web_user_id,role_id,is_delete) values
		<foreach collection="list" item="item" index="index"
			separator=",">
			(#{item.id},#{item.roleId},#{item.isDelete})
		</foreach>
	</insert>

	<delete id="deleteBasketWebUserRoleById" parameterType="Long">
		delete from basket_web_user_role
		where web_user_id = #{id}
	</delete>

	<update id="updateBasketWebUserRoleById" parameterType="com.zhs.model.BasketWebUserRole">
		update basket_web_user_role set
		<set>
			role_id = #{roleId},
			is_delete = #{isDelete},
		</set>
		where web_user_id = #{id}
	</update>

	<update id="updateNotNullBasketWebUserRoleById" parameterType="com.zhs.model.BasketWebUserRole">
		update basket_web_user_role
		<set>
			<if test="roleId != null">role_id = #{roleId},</if>
			<if test="isDelete != null">is_delete = #{isDelete},</if>
		</set>
		where web_user_id = #{id}
	</update>

</mapper>
