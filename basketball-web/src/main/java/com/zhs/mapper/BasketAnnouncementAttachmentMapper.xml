		where  id  =  #{id}
	</delete>



	<!-- 通过BasketAnnouncementAttachment的id将BasketAnnouncementAttachment的数据更新到数据库中对应的表,包括值null的数据 -->
	<update id="updateBasketAnnouncementAttachmentById" parameterType="com.zhs.model.BasketAnnouncementAttachment"> 
		update basket_announcement_attachment set
		<set>
			announcement_id = #{announcementId} , 
			file_id = #{fileId} , 
			attachment_name = #{attachmentName} , 
			sort_no = #{sortNo} , 
			download_count = #{downloadCount} , 
			create_time = #{createTime} , 
			update_time = #{updateTime} , 
			is_delete = #{isDelete} , 
		</set>
		where id = #{id}
	</update>
	
	<!-- 通过BasketAnnouncementAttachment的id将BasketAnnouncementAttachment中属性值不为null的数据更新到数据库对应的表中 -->
	<update id="updateNotNullBasketAnnouncementAttachmentById" parameterType="com.zhs.model.BasketAnnouncementAttachment">
		update basket_announcement_attachment
		<set>
					<if test="announcementId != null">announcement_id = #{announcementId},</if>
