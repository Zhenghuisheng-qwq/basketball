# basketball-web deploy env example (copy to real .env / systemd EnvironmentFile)
# No secrets in this file.

# SPRING_PROFILES_ACTIVE=prod

# Mail verification Dev Bypass (highest priority over application-*.yml)
# local / public test / boss acceptance: true
# before real users: must set false + real mailbox register smoke
CNPA_MAIL_DEV_BYPASS=true

# Required when bypass=false
# CNPA_MAIL_HOST=smtp.qq.com
# CNPA_MAIL_PORT=465
# CNPA_MAIL_USERNAME=
# CNPA_MAIL_AUTH_CODE=
# CNPA_MAIL_FROM=
# CNPA_MAIL_FROM_NAME=CNPA