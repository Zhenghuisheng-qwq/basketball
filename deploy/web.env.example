# basketball-web production EnvironmentFile example.
# Copy to a real env file outside git. Never put real secrets here.

SPRING_PROFILES_ACTIVE=prod
CNPA_MAIL_DEV_BYPASS=false

# Bind basketball-web to loopback when Nginx is on the same host.
CNPA_WEB_BIND=127.0.0.1

CNPA_DB_USERNAME=root
CNPA_DB_PASSWORD=
CNPA_REDIS_PASSWORD=
CNPA_MAIL_USERNAME=
CNPA_MAIL_PASSWORD=
CNPA_MAIL_AUTH_CODE=
CNPA_MAIL_FROM=
CNPA_MAIL_FROM_NAME=CNPA
CNPA_COS_SECRET_ID=
CNPA_COS_SECRET_KEY=
CNPA_FIELD_AES_KEY=

# Same-origin /basket proxy: leave empty.
# Only set if the official site uses a different API origin.
CNPA_CORS_ALLOWED_ORIGINS=

# Extra trusted reverse proxies besides 127.0.0.1 / ::1.
CNPA_TRUSTED_PROXIES=

CNPA_RATE_PUBLIC_NORMAL=180
CNPA_RATE_PUBLIC_HIGH_COST=60
CNPA_RATE_USER_WRITE=30
CNPA_RATE_AUTH=40
